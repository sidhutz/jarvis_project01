# Copy this file to .env and put your own credentials here. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
# Optional: set this only when you want to force a specific model. Otherwise
# Jarvis automatically selects a model your Groq account can access.
# GROQ_MODEL=openai/gpt-oss-20b
OPENWEATHER_API_KEY=your_openweather_api_key_here
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here
